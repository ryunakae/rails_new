{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./app/assets/builds",
    "rootDir": "./app/javascript",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/javascript/*"]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": ["./app/javascript/**/*"],
  "exclude": ["node_modules", "app/assets/builds"]
}
